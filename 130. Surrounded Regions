class Solution:
    def solve(self, board: list[list[str]]) -> None:
        """
        Do not return anything, modify board in-place instead.
        """
        # approach BFS
        # checking the boundaries first if 'O', mark them as '#' since they cannot be converted to 'X', then check the cells which are connected to boundaries and mark them as '#', since they also cannot be converted to 'X'.
        # then convert the remaining 'O' to 'X' and and '#' to 'O'
        q = deque()
        for i in range (len(board)):
            for j in range (len(board[0])):
                if(i==0 or i==(len(board)-1) or j==0 or j==(len(board[0])-1)):
                    if board[i][j] == "O":
                        q.append((i,j))
                        board[i][j] = "#"

        directions = [(1,0),(-1,0),(0,1),(0,-1)]
        while q:
            i, j = q.popleft()

            for x,y in directions:
                nx, ny = i+x, j+y

                if(0<=nx<len(board) and 0<=ny<len(board[0]) and board[nx][ny] == "O"):
                    board[nx][ny] = "#"
                    q.append((nx,ny))
        

        for i in range(len(board)):
            for j in range(len(board[0])):
                if board[i][j] == "O":
                    board[i][j] = "X"
                elif board[i][j] == "#":
                    board[i][j] = "O"

        

        
