class Solution:
    maxarea = 0
    area = 0

    # approach 
    # dfs to calculate the area of island. Once dfs called returns store the island area (do this for every island, and area is stored using max)
    def dfs(self, st, en, grid, visited):

        if (st>=len(grid) or en>=len(grid[0])) or (st<0 or en<0) or (visited[st][en] or grid[st][en] == 0):
            return

        visited[st][en] = True
        self.area = self.area + 1
        self.dfs(st-1, en, grid, visited)
        self.dfs(st+1, en, grid, visited)
        self.dfs(st, en+1, grid, visited)
        self.dfs(st, en-1, grid, visited)


    def maxAreaOfIsland(self, grid: list[list[int]]) -> int:

        visited = [[False for _ in range(len(grid[0]))] for _ in range(len(grid))]

        for i in range(len(grid)):
            for j in range(len(grid[0])):
                self.area = 0
                if not visited[i][j] and grid[i][j] == 1:
                    self.dfs(i, j, grid, visited)
                    self.maxarea = max(self.maxarea, self.area)
                    self.area = 0


        return self.maxarea
        
