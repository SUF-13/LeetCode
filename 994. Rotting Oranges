class Solution:

    def orangesRotting(self, grid: list[list[int]]) -> int:

        # approach
        # use breadth first search, explore neighbors of a rotten orange, if fresh make then rotten , reduce fresh, and add the rotten one in the queue.

        q = deque()
        mins = 0
        fresh = 0

        for i in range(len(grid)):
            for j in range(len(grid[0])):
                if grid[i][j] == 1:
                    fresh = fresh + 1
                elif grid[i][j] == 2:
                    q.append((i,j))

        directions = [(-1,0),(1,0),(0,-1),(0,1)]

        while q and fresh>0:

            for _ in range(len(q)):
                i,j = q.popleft()

                for (x,y) in directions:
                    nx, ny = x+i, j+y

                    if(0<=nx<len(grid) and 0<=ny<len(grid[0]) and grid[nx][ny]==1):
                        grid[nx][ny] = 2
                        q.append((nx, ny))
                        fresh = fresh - 1

            mins = mins + 1

        return mins if fresh == 0 else -1
